  "paths": {
    "/billing/api/v1/checkout": {
      "post": {
        "operationId": "billing_api_v1_checkout_create",
        "description": "Overridable serializer seam for every billing APIView.\n\nHost projects can swap the request/response serializer of any view by\nsubclassing and setting ``request_serializer_class`` /\n``response_serializer_class`` (or overriding the getters for\nper-request decisions) — no need to rewrite the HTTP method bodies.\n\n**Permissions:** `IsAuthenticated`",
        "tags": [
          "Checkout"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
