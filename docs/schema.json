    "/billing/api/v1/subscription/cancel": {
      "post": {
        "operationId": "billing_api_v1_subscription_cancel_create",
        "description": "Cancel the authenticated user's subscription. Cancels the subscription at the Stripe provider (when one exists) and marks it cancelled locally. Takes no request body.\n\n**Permissions:** `IsAuthenticated`",
        "tags": [
          "Subscription"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
