    "/billing/api/v1/webhooks/stripe": {
      "post": {
        "operationId": "billing_api_v1_webhooks_stripe_create",
        "description": "External Stripe webhook endpoint. The request body is a raw Stripe Event object (JSON) whose authenticity is verified against the `Stripe-Signature` header using the configured webhook secret. Events are processed idempotently. Not called by first-party clients.\n\n**Permissions:** `AllowAny`",
        "summary": "Stripe webhook receiver",
        "parameters": [
          {
            "in": "header",
            "name": "Stripe-Signature",
            "schema": {
              "type": "string"
            },
            "description": "Stripe signature header used to verify the event payload.",
            "required": true
          }
        ],
        "tags": [
          "Webhooks"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StapelError"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            },
            "description": ""
          }
        }
      }
    }
